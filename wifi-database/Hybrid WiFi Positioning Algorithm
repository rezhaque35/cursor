FUNCTION GetPosition(wifiScan, knownAPs)
    // Input validation
    visibleAPs = FilterValidAPs(wifiScan, knownAPs)
    apCount = COUNT(visibleAPs)
    
    // 1. Select applicable algorithms based on AP count
    applicableAlgorithms = []
    
    IF apCount == 1 THEN
        applicableAlgorithms.ADD(ProximityDetection)
    ELSE IF apCount == 2 THEN
        applicableAlgorithms.ADD(RSSIRatio)
        applicableAlgorithms.ADD(WeightedCentroid)
    ELSE IF apCount >= 3 THEN
        applicableAlgorithms.ADD(Trilateration)
        applicableAlgorithms.ADD(WeightedCentroid)
        applicableAlgorithms.ADD(MaximumLikelihood)
        applicableAlgorithms.ADD(RSSIRatio)
    END IF
    
    // 2. Evaluate geometric distribution
    geometryFactor = EvaluateAPGeometry(visibleAPs)
    
    IF geometryFactor.isCollinear THEN
        applicableAlgorithms.REMOVE(Trilateration)
    END IF
    
    IF geometryFactor.isClustered THEN
        INCREASE_WEIGHT(MaximumLikelihood)
        INCREASE_WEIGHT(RSSIRatio)
    END IF
    
    // 3. Evaluate signal quality
    signalQuality = EvaluateSignalQuality(wifiScan)
    
    IF signalQuality.isWeak THEN
        INCREASE_WEIGHT(MaximumLikelihood)
    END IF
    
    IF signalQuality.isVariable THEN
        INCREASE_WEIGHT(RSSIRatio)
    END IF
    
    // 4. Evaluate AP location certainty
    locationCertainty = EvaluateAPLocationCertainty(visibleAPs, knownAPs)
    
    IF locationCertainty.isPrecise THEN
        INCREASE_WEIGHT(Trilateration)
    ELSE
        INCREASE_WEIGHT(WeightedCentroid)
    END IF
    
    IF locationCertainty.hasUnknownTransmitPower THEN
        INCREASE_WEIGHT(RSSIRatio)
    END IF
    
    // 5. Calculate positions using all applicable algorithms
    positions = []
    confidences = []
    
    FOR EACH algorithm IN applicableAlgorithms DO
        position = algorithm.Calculate(wifiScan, knownAPs)
        confidence = algorithm.GetConfidence() * algorithm.GetWeight()
        positions.ADD(position)
        confidences.ADD(confidence)
    END FOR
    
    // 6. Combine results using weighted average
    IF positions.COUNT == 0 THEN
        RETURN null
    END IF
    
    finalPosition = WeightedAverage(positions, confidences)
    
    // 7. Calculate error estimate
    errorEstimate = CalculateErrorEstimate(positions, confidences)
    
    RETURN {position: finalPosition, accuracy: errorEstimate}
END FUNCTION

